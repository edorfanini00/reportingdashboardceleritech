# Copy to scripts/.env and fill in. (scripts/.env is git-ignored.)

# --- Microsoft 365 (Azure App Registration) ---
# From your Azure App Registration "Overview" page:
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Your tenant (Directory) ID, or leave as "common" for personal/multi-tenant:
MS_TENANT_ID=common

# John's email address (the sender to scan in YOUR inbox):
JOHN_EMAIL=john@example.com

# --- GoHighLevel ---
# Same credentials the dashboard uses:
GHL_API_KEY=your-ghl-private-integration-or-api-token
GHL_LOCATION_ID=your-location-id

# --- Optional ---
TAG_NAME=sentbyjhon
# MAX_EMAILS=5000

# --- "Sync John" dashboard button (server-side, set these in Vercel) ---
# Microsoft refresh token so the deployed button can read John's mailbox without
# an interactive login. Get it from scripts/.ms-token.json after a local login.
# MS_REFRESH_TOKEN=...
# Enterpryze pipeline / ERP Qualified stage / Natalie (defaults are hardcoded):
# ENTERPRYZE_PIPELINE_ID=FGMXcH1ZySUFZSmV2R00
# ERP_QUALIFIED_STAGE_ID=60a21606-5d7e-402f-85ac-74cde9e57f2f
# NATALIE_USER_ID=4J8l9pZV4WcpYyqtpkj7
# CONTACT_SOURCE=Enterpryze
# SENT_TAG=sentbyjhon
# EXCLUDE_DOMAINS=celeritech.biz,enterpryze.com
